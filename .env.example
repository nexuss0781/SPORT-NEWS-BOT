BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=your_telegram_user_id

# Monitoring via Telegram user account (MTProto)
# Get api_id/api_hash at https://my.telegram.org
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
# Long-lived session string generated locally with a one-time phone login
TELEGRAM_SESSION=your_session_string_here

# Optional: require ?key=<secret> (or Vercel cron header) to trigger /api/monitor
MONITOR_SECRET=
