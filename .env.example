BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=your_telegram_user_id,another_user_id

# Monitoring via Telegram user account (MTProto)
# Get api_id/api_hash at https://my.telegram.org
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
# Long-lived session string generated locally with a one-time phone login
TELEGRAM_SESSION=your_session_string_here

# Runtime settings (Render)
PORT=3000
DATA_DIR=./data
MONITOR_INTERVAL_MS=300000

# Secret required for the optional /refresh HTTP endpoint (?key=<secret>)
MONITOR_SECRET=

# --- Vercel->Render transition (optional; set BOTH to enable) ---
# Stable Vercel domain (NOT VERCEL_URL - Vercel auto-injects that) and Render URL.
PUBLIC_BASE_URL=https://sport-news-bot.vercel.app
RENDER_URL=https://sport-news-bot.onrender.com
# How often Render pushes a storage snapshot to Vercel -> Supabase.
SYNC_INTERVAL_MS=300000

# --- Supabase (persist storage snapshots received by Vercel) ---
# Project URL + Service Role key (server-side only). Table: bot_state.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=