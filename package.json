{
  "name": "sport-news-amharic-bot",
  "version": "1.1.0",
  "description": "Telegram bot that monitors channels and translates posts to Amharic",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "login": "ts-node-dev --transpile-only scripts/login.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/dotenv": "^6.1.1",
    "@vitalets/google-translate-api": "^9.2.0",
    "dotenv": "^17.4.2",
    "grammy": "^1.21.1",
    "telegram": "^2.26.22",
    "teleproto": "^1.229.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vercel/node": "^12.0.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
